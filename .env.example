# ResearchGram environment variables
#
# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Required by the app (both are exposed to the browser by design — the anon key
# is safe to publish ONLY because Row Level Security is enforced on every table)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Optional: the public address of the site. Used for search-engine and
# link-preview addresses (sitemap.xml, robots.txt, og:image). Defaults to
# https://research-gram.vercel.app; set it when a custom domain is added.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.example.org

# ---------------------------------------------------------------------------
# Optional: "Verify with ORCID" on the profile (proves an ORCID iD is yours).
# Only the client id goes here; it is public by design. The client SECRET goes
# into Supabase Vault (see supabase/README.md), never into this file or Vercel.
# Leave empty to hide the button. Use https://sandbox.orcid.org with an ORCID
# sandbox app while testing (and the same value as orcid_base_url in Vault).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ORCID_BASE_URL=https://orcid.org

# ---------------------------------------------------------------------------
# Optional: the bot check (Cloudflare Turnstile) on sign-up, login and
# "forgot password". Only the SITE key goes here; it is public by design. The
# SECRET key goes into Supabase (Authentication -> Attack Protection), never
# into this file or Vercel. Leave empty to hide the check; while Supabase
# requires it, sign-in then fails, so set this first (supabase/README.md).
# Cloudflare's test key 1x00000000000000000000AA always passes, but only for a
# Supabase project whose CAPTCHA uses the test secret (a development project).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ---------------------------------------------------------------------------
# Optional: the contact address shown in the Privacy Policy and Terms. Use an
# address that someone reads. Empty: the pages say a contact is being set up.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.org

# ---------------------------------------------------------------------------
# Research assistant. Server only: never give these a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-google-ai-studio-key
# AI_PROVIDER=gemini                  # "gemini" (default) or "anthropic"; changing it means
#                                     # updating the Privacy Policy and TERMS_VERSION first
# GEMINI_MODEL=gemini-3.5-flash-lite  # one model, or several separated by commas (tried in order)
# GEMINI_FAST_MODEL=                  # model for sorting questions; empty = GEMINI_MODEL
# GEMINI_THINKING_BUDGET=             # only for models that accept a thinking budget
# ANTHROPIC_API_KEY=                  # only when AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Literature search (optional)
# ---------------------------------------------------------------------------
# OPENALEX_MAILTO=you@example.org     # an email address puts requests in OpenAlex's faster pool
# SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# Required only by scripts/seedResearchGramDemoData.mjs
#
# The service role key bypasses Row Level Security completely. Keep it out of
# the browser, out of git, and out of any NEXT_PUBLIC_* variable. Point the seed
# script at a scratch project only — never at production.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
