{
  "name": "researchgram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:db && npm run test:scripts && npm run test:e2e",
    "test:db": "node tests/db/run.mjs",
    "test:scripts": "node tests/scripts/backupStorage.test.mjs",
    "test:e2e": "playwright test",
    "check:apis": "node --env-file=.env.local scripts/checkScholarApis.mjs",
    "check:ai": "node --env-file=.env.local scripts/checkGemini.mjs",
    "backup:files": "node --env-file=.env.backup scripts/backupStorage.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
